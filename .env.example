EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use true para abrir a demonstração local, ou false para habilitar o Supabase.
EXPO_PUBLIC_DEMO_MODE=true

# Para builds próprios do mapa no Android, informe a chave restrita e o pacote.
GOOGLE_MAPS_ANDROID_API_KEY=
BIOOLEO_ANDROID_PACKAGE=

# Opcional. Informe ambos os valores ao usar outro provedor de mapa-base web.
# EXPO_PUBLIC_MAPA_WEB_URL=
# EXPO_PUBLIC_MAPA_WEB_ATRIBUICAO=
